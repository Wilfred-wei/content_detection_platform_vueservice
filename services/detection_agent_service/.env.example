AGENT_HOST=127.0.0.1
AGENT_PORT=8020
PI_PROVIDER=openai
PI_MODEL=gpt-5.4
PI_API_KEY=
# Optional alternative to PI_API_KEY. Supports a raw secret file or a small JSON object.
PI_API_KEY_FILE=
# Defaults to the provider key name, such as OPENAI_API_KEY.
PI_API_KEY_FILE_FIELD=
# Optional OpenAI-compatible endpoint override, for example http://127.0.0.1:8000/v1
PI_BASE_URL=
# Set only for a trusted local endpoint that does not require authentication.
PI_ALLOW_ANONYMOUS=false
AGENT_ALLOW_RUNTIME_CONFIG=true
AGENT_MAX_SESSIONS=50
AGENT_MAX_MESSAGES_PER_SESSION=40
AGENT_ANALYSIS_DATA_DIR=.data/analyses
AGENT_MAX_IMAGE_BYTES=10485760
# Optional JSON array. When set, device-level slot and memory admission is enforced across all models on that device.
# Example: [{"device":"cuda:0","memoryMb":16384,"slots":1}]
AGENT_MODEL_DEVICE_CAPACITIES=
# Required in NODE_ENV=production. Generate with: openssl rand -hex 32
AGENT_STORAGE_ENCRYPTION_KEY=
# Keep false until the immutable release-evidence report and manual promotion pass.
# In NODE_ENV=production, true is required before probabilistic AI labels can publish.
AGENT_PRODUCTION_LABELING_AUTHORIZED=false
# Optional override. The default is .tools/c2patool/bin/c2patool.
C2PATOOL_PATH=
# Optional override. The default is resources/c2pa-settings.v1.toml.
C2PA_SETTINGS_PATH=
# Optional local PEM bundle from the official C2PA trust list. Remote trust-list fetches are disabled.
C2PA_TRUST_ANCHORS_PATH=
# Optional comma-separated issuer-name constraints applied after trust-chain validation.
C2PA_TRUSTED_ISSUERS=
# Logical device visible to the isolated Meta watermark worker.
META_WATERMARKS_DEVICE=cuda:0
# Optional local DDA DINOv2-LoRA detector. All artifact paths and the digest are required when enabled.
DDA_ENABLED=false
DDA_SOURCE_DIR=/absolute/path/to/DDA-source
DDA_DETECTOR_VERSION=DDA-official-neurips2025
DDA_CHECKPOINT_PATH=/absolute/path/to/DDA_ckpt.pth
DDA_CHECKPOINT_SHA256=
DDA_DINOV2_HUB_DIR=/absolute/path/to/facebookresearch_dinov2_main
DDA_DEVICE=cuda:0
DDA_TIMEOUT_MS=30000
DDA_STARTUP_TIMEOUT_MS=180000
DDA_MAX_QUEUE=8
# Optional resource declarations required when AGENT_MODEL_DEVICE_CAPACITIES has a known GPU budget.
DDA_MEMORY_RESERVATION_MB=
DDA_SLOT_COUNT=1
# Worker-level batch protocol is available; keep 1 until the target GPU is benchmarked.
DDA_MICROBATCH_SIZE=1
DDA_MAX_BATCH_DELAY_MS=

# Optional replacement-checkpoint shadow evaluation. The normal DDA result remains the only
# result visible to evidence and AI decisioning; candidate comparisons go to a private JSONL audit.
DDA_SHADOW_ENABLED=false
DDA_SHADOW_CHECKPOINT_PATH=/absolute/path/to/candidate.pth
DDA_SHADOW_CHECKPOINT_SHA256=
DDA_SHADOW_MANIFEST_PATH=/absolute/path/to/selected_candidate.json
DDA_SHADOW_MANIFEST_SHA256=
DDA_SHADOW_DEVICE=cuda:0
DDA_SHADOW_TIMEOUT_MS=30000
DDA_SHADOW_STARTUP_TIMEOUT_MS=180000
DDA_SHADOW_MAX_QUEUE=8
DDA_SHADOW_MEMORY_RESERVATION_MB=
DDA_SHADOW_SLOT_COUNT=1
DDA_SHADOW_MICROBATCH_SIZE=1
DDA_SHADOW_MAX_BATCH_DELAY_MS=
# Defaults to <AGENT_ANALYSIS_DATA_DIR>/shadow/dda-universal-v1.jsonl.
DDA_SHADOW_AUDIT_LOG_PATH=

# Experimental local MIRROR route. Never enable this in NODE_ENV=production.
MIRROR_ENABLED=false
MIRROR_SOURCE_DIR=/absolute/path/to/MIRROR-source
MIRROR_SOURCE_REVISION=18c56efa303d96f038a6aac4e11ba1a512a2cbde
MIRROR_CHECKPOINT_PATH=/absolute/path/to/checkpoint-h-cur.pth
MIRROR_CHECKPOINT_SHA256=
MIRROR_MEMORY_BANK_PATH=/absolute/path/to/mirror_phase1.pth
MIRROR_MEMORY_BANK_SHA256=
MIRROR_BACKBONE_DIR=/absolute/path/to/dinov3-huge
MIRROR_BACKBONE_SHA256=
MIRROR_DEVICE=cuda:1
MIRROR_USE_AMP=false
MIRROR_TIMEOUT_MS=60000
MIRROR_STARTUP_TIMEOUT_MS=300000
MIRROR_MAX_QUEUE=4
MIRROR_MEMORY_RESERVATION_MB=
MIRROR_SLOT_COUNT=1
# Worker-level batch protocol is available; keep 1 until the target GPU is benchmarked.
MIRROR_MICROBATCH_SIZE=1
MIRROR_MAX_BATCH_DELAY_MS=

# Provisional SAFE route. Scores remain supporting-only until deployment calibration passes.
SAFE_ENABLED=false
SAFE_SOURCE_DIR=/absolute/path/to/SAFE
SAFE_SOURCE_REVISION=4e998724651b227def64f5be0cd60c0aa1552c35
SAFE_SOURCE_SHA256=f0d3956e8586f0c122a06f2b674799f21b82d65690b3460b06e15679ae7be528
SAFE_CHECKPOINT_PATH=/absolute/path/to/checkpoint-best.pth
SAFE_CHECKPOINT_SHA256=b3f5ecfb46a154ed553aaaf4bf3ba59182310726ddb0cbb1fe42bd0e22d2f20e
SAFE_DEVICE=cuda:0
SAFE_TIMEOUT_MS=30000
SAFE_STARTUP_TIMEOUT_MS=180000
SAFE_MAX_QUEUE=8
SAFE_MEMORY_RESERVATION_MB=
SAFE_SLOT_COUNT=1
# Worker-level batch protocol is available; keep 1 until the target GPU is benchmarked.
SAFE_MICROBATCH_SIZE=1
SAFE_MAX_BATCH_DELAY_MS=
