# Only needed when the Vite development server is exposed through a public reverse proxy.
# Set to true for stable phone or demo access where hot reload is not needed.
VITE_HMR_DISABLED=false
VITE_HMR_HOST=example.com
VITE_HMR_PROTOCOL=wss
VITE_HMR_CLIENT_PORT=443
VITE_GATEWAY_TARGET=http://127.0.0.1:28000
